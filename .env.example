# ProductMind AI 环境变量示例
# 复制为 .env 后填写；.env 已在 .gitignore 中，切勿提交真实密钥。

# =====================================================================
# LLM 配置（二选一）
# 切换方式：启用其中一套、注释掉另一套。两套都注释则使用代码默认值
# （provider=deepseek、model=deepseek-chat、官方端点）。
# =====================================================================

# ---------------------------------------------------------------------
# 方案 A：DeepSeek 官方
# ---------------------------------------------------------------------
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-deepseek-key
# 留空使用 DeepSeek 官方预设端点；DeepSeek 官方无需填写
LLM_BASE_URL=
LLM_MODEL=deepseek-chat

# ---------------------------------------------------------------------
# 方案 B：第三方中转站（OpenAI 兼容）
# ---------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-relay-key
# 中转站必须填写其 OpenAI 兼容端点（通常以 /v1 结尾）
# LLM_BASE_URL=https://your-relay.example.com/v1
# 填中转站实际提供的模型名
# LLM_MODEL=gpt-4o-mini

# 通用 LLM 参数（两套共用，无需随方案切换）
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.3

# ===== Agent / 工作流（MVP）=====
# 单 Agent 失败后的最大重试次数
AGENT_MAX_RETRIES=1
# 每个确认闸门（需求 / 技术方案）的最大修改轮次，超限跳过该闸门
MAX_REVIEW_ROUNDS=3
# true 时两个确认闸门均不中断、自动通过（测试 / 无人值守演示）
AUTO_APPROVE=false
# product_document.md 输出目录
OUTPUT_DIR=./output

# ===== LangSmith 流程监控（可选）=====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=productmind-ai

# ===== RAG（Phase 2）=====
# Ollama 本地服务端点，需先启动 Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Ollama 中的 BGE embedding 模型（如 bge-m3 / bge-large-zh）
EMBEDDING_MODEL=bge-m3
# Chroma 本地持久化目录
CHROMA_PERSIST_DIR=./data/chroma
