# ProductMind AI 环境变量示例
# 复制为 .env 后填写；.env 已在 .gitignore 中，切勿提交真实密钥。
# LLM 接入为 LangChain ChatModel（OpenAI 兼容）：provider 决定预设端点/模型，
# 显式 LLM_BASE_URL / LLM_MODEL 可覆盖预设。

# =====================================================================
# LLM 配置（四选一，启用其中一套、注释掉其余；全注释则用代码默认值：
# provider=deepseek、model=deepseek-chat、官方端点）
# =====================================================================

# ---- 方案 A：DeepSeek 官方（默认）----
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-deepseek-key
# 留空使用 DeepSeek 官方预设端点
LLM_BASE_URL=
LLM_MODEL=deepseek-chat

# ---- 方案 B：OpenAI 官方 ----
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-openai-key
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini

# ---- 方案 C：阿里云百炼 Qwen（OpenAI 兼容）----
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-your-dashscope-key
# LLM_BASE_URL=
# LLM_MODEL=qwen-plus

# ---- 方案 D：第三方中转站（OpenAI 兼容）----
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-relay-key
# 中转站必须填写其 OpenAI 兼容端点（通常以 /v1 结尾）
# LLM_BASE_URL=https://your-relay.example.com/v1
# LLM_MODEL=填写中转站实际提供的模型名

# 可选：按 Provider 分别配置 Key（未设置 LLM_API_KEY 时生效）
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# QWEN_API_KEY=

# 通用 LLM 参数（各方案共用）
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.3

# ===== Agent / 工作流（MVP）=====
# 单个 Agent 失败后的最大重试次数
AGENT_MAX_RETRIES=1
# 每个确认闸门 / Reviewer 自动评审的最大修改轮次，超限按通过处理
MAX_REVIEW_ROUNDS=3
# Supervisor 动态路由的最大步数，超过则强制收敛
MAX_ROUTING_STEPS=12
# true 时两个确认闸门均不中断、自动通过（离线测试 / 无人值守演示）
AUTO_APPROVE=false
# product_document.md 输出目录
OUTPUT_DIR=./output

# ===== Web 服务（可选，默认 127.0.0.1:8000）=====
# HOST=127.0.0.1
# PORT=8000
# RELOAD=false

# ===== 存储：PostgreSQL（运行元数据 + LangGraph 检查点）=====
# 逻辑：任务元数据、检查点统一存 PostgreSQL；数据库仅能经跳板机访问时启用 SSH 隧道。
# 注意：PG_HOST/PG_PORT 填「数据库在内网的真实地址」，隧道会把远端端口转发到本地。
# memory=不落库（默认，离线可用）；postgres=启用持久化（连不上会自动降级为 memory）
STORAGE_BACKEND=memory
DATA_DIR=./data
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=productmind
PG_USER=productmind
PG_PASSWORD=
PG_SSLMODE=prefer
# 启动时自动恢复中断的 running 任务
RECOVER_ON_STARTUP=true
# >0 时清理超过 N 天的已完成任务（0=不清理）
RUN_RETENTION_DAYS=0

# ===== SSH 隧道（可选；数据库仅能经跳板机访问时启用）=====
SSH_ENABLED=false
SSH_HOST=
SSH_PORT=22
SSH_USER=
# 私钥路径（放入 secrets/ssh/，权限 600，见 secrets/ssh/README.md）
SSH_KEY_PATH=./secrets/ssh/id_ed25519
# 私钥口令（无则留空）
SSH_KEY_PASSPHRASE=
# 已知主机文件（可 ssh-keyscan 生成）
SSH_KNOWN_HOSTS=./secrets/ssh/known_hosts
# 本地转发地址；端口 0 表示自动分配
SSH_LOCAL_BIND_HOST=127.0.0.1
SSH_LOCAL_BIND_PORT=0

# ===== Langfuse 流程追踪（可选）=====
LANGFUSE_ENABLED=false
# 在 Langfuse 控制台创建项目后获取（Settings -> API Keys）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 自托管时改为你的地址；云端默认留空或填 https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ===== RAG（Phase 2，依赖暂未安装）=====
# Ollama 本地服务端点，需先启动 Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Ollama 中的 BGE embedding 模型（如 bge-m3 / bge-large-zh）
EMBEDDING_MODEL=bge-m3
# Chroma 本地持久化目录
CHROMA_PERSIST_DIR=./data/chroma
